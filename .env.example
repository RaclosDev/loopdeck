# Configuración para Docker Compose en Producción (Oracle Cloud)

# Base de datos PostgreSQL
PGDATABASE=loopdeck
PGUSER=postgres
PGPASSWORD=cambia_esta_contrasena

# Seguridad (Usa un string de al menos 32 caracteres)
JWT_SECRET=super_secret_jwt_key_that_is_long_enough_123

# IA (Gemini)
GEMINI_API_KEY=tu_api_key_de_gemini
