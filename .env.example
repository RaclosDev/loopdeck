# Database
POSTGRES_USER=loopdeck
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=loopdeck_db
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Backend Secrets
JWT_SECRET=CHANGE_ME_SECRET_AT_LEAST_32_CHARS
GOOGLE_CLIENT_ID=CHANGE_ME
GEMINI_API_KEY=CHANGE_ME
# Modelo de Gemini (estable). Revisa https://aistudio.google.com/docs/deprecations al actualizar
GEMINI_MODEL=gemini-3.8-flash
# Nivel de razonamiento: low, medium o high (vacío = el del modelo)
GEMINI_THINKING_LEVEL=medium
# Modelos de reserva, separados por comas, si el principal está saturado (503/429)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash
# Modelo rápido para las definiciones sueltas (la generación masiva y el chat usan GEMINI_MODEL)
GEMINI_DEFINITION_MODEL=gemini-3.5-flash-lite
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Llaves de acceso: en local, localhost y el origen del frontend.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:5173
# Recuperar contraseña por correo (Resend). Sin RESEND_API_KEY no se envía nada.
# APP_PUBLIC_URL es la URL pública del frontend, la que llevan los enlaces de los correos.
RESEND_API_KEY=
MAIL_FROM=LoopDeck <no-reply@raclos.es>
APP_PUBLIC_URL=http://localhost:5173

# Frontend variables (Optional if built externally)
VITE_API_URL=http://localhost:8080/api
